# Server
PORT=3000

# Anthropic API (used for pre-visit and post-visit LLM summaries)
# Get a key at https://console.anthropic.com/
# If left blank, the system falls back to a rule-based summary instead of
# breaking the booking / notes flow (see src/services/llmService.js).
ANTHROPIC_API_KEY=

# Email (notifications). If left blank, emails are only logged to
# data/emails.log and printed to the console (safe default for local demo).
# To send real email, set these and flip EMAIL_MODE to "smtp" and wire in
# your provider of choice (SendGrid / Mailgun / Nodemailer) inside
# src/services/emailService.js — the function signatures are already in place.
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=clinic@example.com

# Google Calendar (currently mocked as downloadable .ics files under
# /calendar_events so the demo needs no OAuth setup). To wire up real
# Google Calendar events, see the "Upgrading to real Google Calendar" section
# of the README and src/services/calendarService.js.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Simple auth token secret (demo-grade, not JWT) — change this in production
AUTH_SECRET=change-this-demo-secret
